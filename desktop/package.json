{
  "name": "alpacabitollama",
  "version": "1.0.0",
  "description": "Desktop application for llama.cpp with system tray, auto model downloads, and integrated documentation",
  "main": "main.js",
  "scripts": {
    "copy-webui": "node build-webui.js",
    "copy-docs": "node build-docs.js",
    "build:jcm": "node scripts/build-jcm.js",
    "generate:trusted-manifest": "node scripts/generate-trusted-artifact-manifest.js",
    "verify:trusted-manifest": "node scripts/verify-trusted-artifact-manifest.js",
    "stage:release-artifacts": "node scripts/stage-release-artifacts.js",
    "release:evidence": "node scripts/collect-phase1-release-evidence.js",
    "test": "vitest run",
    "test:scheduling": "node --test tests/scheduling/*.test.js",
    "test:coverage": "vitest run --coverage",
    "start": "electron .",
    "clean": "node clean-dist.js",
    "build": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder",
    "build:win": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --win",
    "build:mac": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --mac",
    "build:linux": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --linux",
    "build:portable": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --win portable",
    "build:installer": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --win nsis",
    "build:dmg": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --mac --x64 --config.dmg.target=dmg",
    "build:pkg": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --mac --x64 --config.pkg.target=pkg",
    "build:appimage": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --linux --x64 --config.linux.target=AppImage",
    "build:deb": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --linux --x64 --config.linux.target=deb",
    "build:rpm": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --linux --x64 --config.linux.target=rpm",
    "build:snap": "npm run clean && npm run build:jcm && npm run copy-webui && npm run copy-docs && electron-builder --linux --x64 --config.linux.target=snap"
  },
  "build": {
    "appId": "com.ggml.llamacpp",
    "productName": "alpacabitollama",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "binary-manager.js",
      "api-server.js",
      "request-manager.js",
      "splash-manager.js",
      "lazy-start-manager.js",
      "planning/**/*",
      "scheduling/**/*",
      "providers/**/*",
      "feature-gates.js",
      "logs-viewer.js",
      "public/**/*",
      "docs/**/*",
      "bin/**/*",
      "resources/**/*",
      "*.html",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "public/**/*",
      "bin/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/alpaca.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/alpaca.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Alpacabitollama-${version}-macOS.dmg",
      "title": "Alpacabitollama",
      "background": "resources/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 144,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "pkg": {
      "artifactName": "Alpacabitollama-${version}-macOS.pkg",
      "installLocation": "/Applications",
      "background": {
        "file": "resources/pkg-background.png",
        "alignment": "center",
        "scaling": "tofit"
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/alpaca.png",
      "category": "Development",
      "maintainer": "Alpacabitollama Team",
      "vendor": "Alpacabitollama",
      "synopsis": "Local AI Chat & Development Platform",
      "description": "Alpacabitollama brings the power of local LLM inference to everyday users through an intuitive desktop application with a modern chat interface and model management."
    },
    "appImage": {
      "artifactName": "Alpacabitollama-${version}-linux.AppImage",
      "synopsis": "Local AI Chat & Development Platform"
    },
    "deb": {
      "artifactName": "alpacabitollama_${version}_amd64.deb",
      "depends": [
        "gconf2",
        "gconf-service",
        "libnotify4",
        "libappindicator1",
        "libxtst6",
        "libnss3"
      ]
    },
    "rpm": {
      "artifactName": "alpacabitollama-${version}.x86_64.rpm",
      "depends": [
        "gconf2",
        "gconf-service",
        "libnotify4",
        "libappindicator",
        "libxtst",
        "nss"
      ]
    },
    "snap": {
      "artifactName": "alpacabitollama_${version}_amd64.snap",
      "grade": "stable",
      "confinement": "strict",
      "plugs": [
        "desktop",
        "desktop-legacy",
        "home",
        "network",
        "network-bind",
        "removable-media",
        "unity7"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "Alpacabitollama-Setup-${version}.exe",
      "include": "installer.nsh",
      "installerIcon": "resources/alpaca.ico",
      "uninstallerIcon": "resources/alpaca.ico",
      "license": "LICENSE",
      "perMachine": false,
      "allowElevation": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "portable": {
      "artifactName": "Alpacabitollama-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "optionalDependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "fast-check": "4.9.0",
    "vitest": "3.2.4"
  }
}
